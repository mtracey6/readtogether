# Required
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated allow list. Set to your Vercel domain(s) in production.
FRONTEND_URL=https://your-project.vercel.app,https://www.yourdomain.com

# Optional — defaults shown
PORT=8787
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOKENS=2000
PER_IP_PER_HOUR=6
GLOBAL_PER_DAY=250
